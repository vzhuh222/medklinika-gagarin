# Локальная разработка работает без этого файла: SQLite, порт 3000.
# Копируйте в .env только когда подключаете внешние сервисы.

# Сервер
PORT=3000
SITE_URL=http://localhost:3000

# Время жизни сессии сотрудника в часах
SESSION_TTL_HOURS=12

# Разрешённые источники для CORS (в production по умолчанию только свой домен)
CORS_ORIGIN=

# PostgreSQL (только для production; без переменной используется локальный SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/medklinika

# Яндекс.Карты — https://developer.tech.yandex.ru/
YANDEX_MAPS_API_KEY=

# Email (SMTP)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medklinika.ru

# SMS — https://sms.ru/
SMS_PROVIDER=smsru
SMSRU_API_ID=
SMS_FROM=MedKlinika

# ЮKassa — https://yookassa.ru/
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# МедФлекс / МедЛок — после договора с help@medrocket.ru
MEDFLEX_ENABLED=false
MEDFLEX_MODE=native
# native — запись на сайте + синхронизация в МедЛок
# widget — только виджет МедФлекс (расписание из МедЛок)
# both — и форма сайта, и виджет
MEDFLEX_WEBHOOK_URL=
MEDFLEX_API_KEY=
MEDFLEX_PARTNER_ID=
MEDFLEX_WIDGET_HTML=
MEDLOCK_BRANCH_ID=

# 1С
ONEC_EXPORT_ENABLED=true
ONEC_ORG_NAME=ООО «МедКлиника на Гагарина»

# 152-ФЗ — оператор персональных данных
PD_OPERATOR_NAME=ООО «МедКлиника на Гагарина»
PD_OPERATOR_INN=
PD_OPERATOR_ADDRESS=Владимирская обл., г. Киржач, ул. Гагарина, 37
PD_DPO_EMAIL=privacy@medklinika.ru
PD_RETENTION_DAYS=1095

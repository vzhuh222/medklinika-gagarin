# Сервер
PORT=3000
SITE_URL=https://medklinika-gagarin.ru

# PostgreSQL (обязательно для production)
DATABASE_URL=postgresql://user:password@localhost:5432/medklinika

# Яндекс.Карты — https://developer.tech.yandex.ru/
YANDEX_MAPS_API_KEY=

# Email (SMTP)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medklinika.ru

# SMS — https://sms.ru/
SMS_PROVIDER=smsru
SMSRU_API_ID=
SMS_FROM=MedKlinika

# ЮKassa — https://yookassa.ru/
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# МедФлекс / МедЛок — после договора с help@medrocket.ru
MEDFLEX_ENABLED=false
MEDFLEX_MODE=native
# native — запись на сайте + синхронизация в МедЛок
# widget — только виджет МедФлекс (расписание из МедЛок)
# both — и форма сайта, и виджет
MEDFLEX_WEBHOOK_URL=
MEDFLEX_API_KEY=
MEDFLEX_PARTNER_ID=
MEDFLEX_WIDGET_HTML=
MEDLOCK_BRANCH_ID=

# 1С
ONEC_EXPORT_ENABLED=true
ONEC_ORG_NAME=ООО «МедКлиника на Гагарина»

# 152-ФЗ — оператор персональных данных
PD_OPERATOR_NAME=ООО «МедКлиника на Гагарина»
PD_OPERATOR_INN=
PD_OPERATOR_ADDRESS=ул. Гагарина, д. 15
PD_DPO_EMAIL=privacy@medklinika.ru
PD_RETENTION_DAYS=1095
